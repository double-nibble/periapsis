#!/bin/bash
set -euo pipefail

# The t4g.nano has 512MB RAM; dnf installs OOM without swap. Add a swapfile first.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=1024
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo "/swapfile none swap sw 0 0" >> /etc/fstab
fi

# Install NATS server (arm64).
NATS_VER="2.10.22"
cd /tmp
curl -sSL "https://github.com/nats-io/nats-server/releases/download/v$${NATS_VER}/nats-server-v$${NATS_VER}-linux-arm64.tar.gz" -o nats.tgz
tar -xzf nats.tgz
install nats-server-*/nats-server /usr/local/bin/nats-server

dnf install -y certbot

# Obtain the TLS cert. DNS may still be propagating at first boot, so retry a
# bounded number of times; NATS starts once the cert exists.
CERT_DIR="/etc/letsencrypt/live/${fqdn}"
for i in $(seq 1 20); do
  if certbot certonly --standalone -n --agree-tos -m "${email}" -d "${fqdn}" --preferred-challenges http; then
    break
  fi
  echo "certbot attempt $i failed (DNS may not have propagated); retrying in 60s"
  sleep 60
done

mkdir -p /etc/nats
cat > /etc/nats/nats.conf <<CONF
host: "127.0.0.1"
port: 4222
websocket {
  port: 443
  tls {
    cert_file: "$${CERT_DIR}/fullchain.pem"
    key_file:  "$${CERT_DIR}/privkey.pem"
  }
}
include "accounts.conf"
CONF
touch /etc/nats/accounts.conf

# Renew automatically; reload NATS to pick up the new cert.
cat > /etc/systemd/system/certbot-renew.service <<RENEW
[Unit]
Description=Renew Let's Encrypt and reload NATS
[Service]
Type=oneshot
ExecStart=/usr/bin/certbot renew --standalone --deploy-hook "systemctl reload nats"
RENEW
cat > /etc/systemd/system/certbot-renew.timer <<TIMER
[Unit]
Description=Daily cert renewal check
[Timer]
OnCalendar=daily
Persistent=true
[Install]
WantedBy=timers.target
TIMER

cat > /etc/systemd/system/nats.service <<UNIT
[Unit]
Description=NATS Server
After=network-online.target
[Service]
ExecStart=/usr/local/bin/nats-server -c /etc/nats/nats.conf
Restart=always
[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now nats
systemctl enable --now certbot-renew.timer
